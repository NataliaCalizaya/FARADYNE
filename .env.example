# ==============================================
# FARADYNE — Variables de Entorno
# Copiar a .env y ajustar los valores
# ==============================================

# --- Backend ---
DATABASE_URL=postgresql://faradyne:faradyne@localhost:5432/faradyne
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=/tmp/faradyne_uploads
MAX_FILE_SIZE_MB=100
DEBUG=true

# --- Database ---
POSTGRES_USER=faradyne
POSTGRES_PASSWORD=faradyne
POSTGRES_DB=faradyne

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=FARADYNE
VITE_APP_VERSION=0.1.0
